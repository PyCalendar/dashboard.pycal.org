## The settings of dashboard.pycal.org: every setting that the site reads, with its description.
##
## Copy this file to .env next to docker-compose.yml and change what you need. A line that starts
## with "# " is a setting that keeps its default, which the line shows: remove the "# " to change
## it. Lines with "##" describe the setting below them. The reference explains each setting:
## https://docs.dashboard.pycal.org/reference/settings.html

######## 1. The address of the site (required) ########

## The address of the site, without "/" at the end. The GitHub App, its webhook and the sign-in
## use it.
SITE_URL=https://dashboard.pycal.org
## The host names of the site, comma separated. The health check of the container sends the
## first one.
ALLOWED_HOSTS=dashboard.pycal.org
## The addresses whose forms the site accepts, comma separated. Default: SITE_URL.
CSRF_TRUSTED_ORIGINS=https://dashboard.pycal.org
## The name of the site in the title of the pages and in its emails.
# SITE_NAME=dashboard.pycal.org

######## 2. The GitHub App ########
## Leave these empty: start the site and register the app on <SITE_URL>/setup/github-app/ with
## the setup code from the log; the site writes them into DATA_DIR/.env. Values here take
## precedence over those of DATA_DIR/.env.

## The numeric id of the app.
GITHUB_APP_ID=
## The name of the app in https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
## The client id of the app. The registration stores it; the site does not sign in with it.
GITHUB_CLIENT_ID=
## The client secret of the app, stored with its client id.
GITHUB_SECRET=
## The secret of the webhooks; without it, every webhook is refused.
GITHUB_WEBHOOK_SECRET=
## The file of the private key of the app.
GITHUB_APP_PRIVATE_KEY_FILE=/app/data/github-app.pem
## Or the private key itself, with \n for the line breaks.
# GITHUB_APP_PRIVATE_KEY=
## The API of GitHub; change it only for GitHub Enterprise Server.
# GITHUB_API=https://api.github.com
## The organizations of the community of the site, comma separated: the start page links them,
## and the registration of the GitHub App proposes the first one as its owner. Every account
## may install the app.
# GITHUB_ORGANIZATIONS=PyCalendar

######## 3. The OAuth app that signs people in (required to sign in) ########
## Create it on GitHub and enter it on <SITE_URL>/setup/oauth-app/ with the setup code from the
## log, which writes it into DATA_DIR/.env, or set it here.

## The client id of the OAuth app.
GITHUB_OAUTH_CLIENT_ID=
## The client secret of the OAuth app.
GITHUB_OAUTH_SECRET=

######## 4. People ########

## GitHub handles that administer the site, comma separated: the Django admin, the log and the
## webhook deliveries.
SITE_ADMINS=
## Minutes after signing in when people are signed out again, also while they use the site; 0:
## never, until they sign out.
# SIGN_OUT_MINUTES=0

######## 5. Data and secrets ########

## The directory of the SQLite database, the secret key and the credentials of the apps.
# DATA_DIR=/app/data
## The secret key of Django; generated once into DATA_DIR if empty.
# SECRET_KEY=
## Another database, such as PostgreSQL; empty: SQLite in DATA_DIR.
# DATABASE_URL=postgres://dashboard:dashboard@db/dashboard
## true only for development: details of errors and no setup code.
# DEBUG=false
## How much the site logs: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

######## 6. Email ########
## The site sends emails, such as the link that verifies an address, through this mail server.

## The mail server; empty: the emails are written into the log.
# EMAIL_HOST=
## The port of the mail server.
# EMAIL_PORT=587
## The user of the mail server.
# EMAIL_HOST_USER=
## The password of the mail server.
# EMAIL_HOST_PASSWORD=
## STARTTLS, usually with port 587; default: true unless EMAIL_USE_SSL.
# EMAIL_USE_TLS=true
## TLS from the start, usually with port 465; default: true for port 465.
# EMAIL_USE_SSL=false
## The sender of the emails; default: dashboard@<SITE_NAME>.
# DEFAULT_FROM_EMAIL=dashboard@dashboard.pycal.org

######## 7. The container ########

## The port of nginx in the container.
# PORT=5000
## The processes of gunicorn. Each one keeps the site in memory: more only for many visitors.
# WORKERS=1
## The threads of each process of gunicorn.
# THREADS=4

######## 8. Links and the icon ########

## The icon: an address or the path of a PNG, ICO or SVG file; empty: the icon of pycal.
# FAVICON=https://pycal.org/favicon.png
## The extra links of the footer: Title=URL, comma separated; empty: none.
# FOOTER_LINKS=pycal.org=https://pycal.org
## The repository of the code, linked in the footer and on the page About.
# SOURCE_URL=https://github.com/PyCalendar/dashboard.pycal.org
## The documentation; the error pages link to it.
# DOCS_URL=https://docs.dashboard.pycal.org/

######## 9. The colors of the light pages ########
## The defaults are the colors of sign.pycal.org.

## Buttons and links.
# COLOR_PRIMARY=#2b5b84
## Buttons and links under the mouse.
# COLOR_PRIMARY_HOVER=#1e3f5c
## The blue of the logo, such as on the start page.
# COLOR_BRAND=#3b79aa
## The yellow of the logo: the button Sign in with GitHub and highlights.
# COLOR_ACCENT=#ffd43b
## The text on the accent color.
# COLOR_ACCENT_TEXT=#1b1f24
## The bar at the top.
# COLOR_NAV=#1e3f5c
## The text of the bar at the top.
# COLOR_NAV_TEXT=#ffffff
## The background of the page and of the cards.
# COLOR_SURFACE=#ffffff
## A tinted background, such as of tables and menus.
# COLOR_SURFACE_TINT=#eef4f9
## The text.
# COLOR_TEXT=#1b1f24
## Less important text, such as hints.
# COLOR_TEXT_MUTED=#4f5b66
## Lines and borders.
# COLOR_BORDER=#c5d3e0
## Success, such as the badge verified.
# COLOR_SUCCESS=#1d6b33
## Warnings, such as the badge not verified.
# COLOR_WARNING=#7a5300
## Errors.
# COLOR_DANGER=#a3242f
## The background of messages of success.
# COLOR_SUCCESS_BG=#e7f4ea
## The background of error messages.
# COLOR_DANGER_BG=#fbe8ea
## The background of warnings.
# COLOR_WARNING_BG=#fdf3d3
## Merged pull requests: purple, as on GitHub.
# COLOR_MERGED=#6639a6
## The background of merged pull requests.
# COLOR_MERGED_BG=#f1e9fb

######## 10. The colors of the dark pages ########

## Buttons and links.
# COLOR_DARK_PRIMARY=#8fbbe0
## Buttons and links under the mouse.
# COLOR_DARK_PRIMARY_HOVER=#c6dcef
## The blue of the logo, such as on the start page.
# COLOR_DARK_BRAND=#3b79aa
## The yellow of the logo: the button Sign in with GitHub and highlights.
# COLOR_DARK_ACCENT=#ffd43b
## The text on the accent color.
# COLOR_DARK_ACCENT_TEXT=#1b1f24
## The bar at the top.
# COLOR_DARK_NAV=#0d1b28
## The text of the bar at the top.
# COLOR_DARK_NAV_TEXT=#ffffff
## The background of the page and of the cards.
# COLOR_DARK_SURFACE=#111820
## A tinted background, such as of tables and menus.
# COLOR_DARK_SURFACE_TINT=#1b2733
## The text.
# COLOR_DARK_TEXT=#d3dae1
## Less important text, such as hints.
# COLOR_DARK_TEXT_MUTED=#a8b5c2
## Lines and borders.
# COLOR_DARK_BORDER=#34475a
## Success, such as the badge verified.
# COLOR_DARK_SUCCESS=#7fd18f
## Warnings, such as the badge not verified.
# COLOR_DARK_WARNING=#f2c55c
## Errors.
# COLOR_DARK_DANGER=#f1aeb5
## The background of messages of success.
# COLOR_DARK_SUCCESS_BG=#14291c
## The background of error messages.
# COLOR_DARK_DANGER_BG=#33181c
## The background of warnings.
# COLOR_DARK_WARNING_BG=#2e2610
## Merged pull requests: purple, as on GitHub.
# COLOR_DARK_MERGED=#c9a6f2
## The background of merged pull requests.
# COLOR_DARK_MERGED_BG=#271c38
