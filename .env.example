## The settings of a deployed site. Copy to .env, then fill in or change what you need.
## A setting with # keeps its default. All settings, explained:
## https://dashboard-pycal-org.readthedocs.io/en/latest/reference/settings.html

######## 1. The address of the site (required) ########
SITE_URL=https://dashboard.pycal.org
ALLOWED_HOSTS=dashboard.pycal.org
CSRF_TRUSTED_ORIGINS=https://dashboard.pycal.org

######## 2. The GitHub App ########
## Leave these empty, start the site and register the app on <SITE_URL>/setup/github-app/
## with the setup code from the log. It writes them into DATA_DIR/.env.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=/app/data/github-app.pem
## Optional: an OAuth app that signs people in instead of the GitHub App.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_SECRET=

######## 3. The dashboard ########
# GITHUB_ORGANIZATIONS=PyCalendar
# STALE_DAYS=30
# SYNC_HOURS=6
## GitHub handles that administer the site, comma separated.
SITE_ADMINS=

######## 4. Data, email, look ########
# DATABASE_URL=postgres://dashboard:dashboard@db/dashboard
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=dashboard@dashboard.pycal.org
# COLOR_PRIMARY=#2b5b84
