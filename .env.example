## Every setting of the site. Copy to .env, then fill in or change what you need.
## A line with # keeps the default that it shows. All settings, explained:
## https://docs.dashboard.pycal.org/reference/settings.html

######## 1. The address of the site (required) ########
SITE_URL=https://dashboard.pycal.org
ALLOWED_HOSTS=dashboard.pycal.org
CSRF_TRUSTED_ORIGINS=https://dashboard.pycal.org
# SITE_NAME=dashboard.pycal.org

######## 2. The GitHub App ########
## Leave these empty, start the site and register the app on <SITE_URL>/setup/github-app/
## with the setup code from the log. The site writes them into DATA_DIR/.env.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=/app/data/github-app.pem
## Or the key itself, with \n for the line breaks.
# GITHUB_APP_PRIVATE_KEY=
## Only for GitHub Enterprise Server.
# GITHUB_API=https://api.github.com
## The organizations of the app, comma separated; webhooks of other accounts are ignored.
# GITHUB_ORGANIZATIONS=PyCalendar

######## 3. The OAuth app that signs people in (required to sign in) ########
## Create it on GitHub and enter it on <SITE_URL>/setup/oauth-app/ with the setup code from
## the log, which writes it into DATA_DIR/.env, or set it here.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_SECRET=

######## 4. People ########
## GitHub handles that administer the site, comma separated: the Django admin and the
## webhook deliveries.
SITE_ADMINS=
## Minutes after signing in when people are signed out again, also while they use the site.
# SIGN_OUT_MINUTES=60

######## 5. Data and secrets ########
# DATA_DIR=/app/data
## Generated once into DATA_DIR if empty.
# SECRET_KEY=
## SQLite in DATA_DIR by default.
# DATABASE_URL=postgres://dashboard:dashboard@db/dashboard
## true only for development: details of errors and no setup code.
# DEBUG=false
# LOG_LEVEL=INFO

######## 6. Email ########
## Without EMAIL_HOST, emails are written into the log.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=dashboard@dashboard.pycal.org

######## 7. The container ########
## The port of nginx in the container, and the processes and threads of gunicorn.
# PORT=5000
# WORKERS=2
# THREADS=4

######## 8. Links and the icon ########
## The icon: an address or the path of a PNG, ICO or SVG file; empty: the icon of pycal.
# FAVICON=https://pycal.org/favicon.png
## The extra links of the footer: Title=URL, comma separated; empty: none.
# FOOTER_LINKS=pycal.org=https://pycal.org
# SOURCE_URL=https://github.com/PyCalendar/dashboard.pycal.org
# DOCS_URL=https://docs.dashboard.pycal.org/

######## 9. Colors ########
