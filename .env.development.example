## Local development: copy this file to .env and fill in what you need. make run reads .env;
## restart it after a change. Keep real credentials out of git. Every setting, with its
## description, is in .env.example; https://docs.dashboard.pycal.org/reference/settings.html

## The address of the site. Empty: http://localhost:5000 (make run sets it and DEBUG=true).
## Behind a tunnel, such as Tailscale Funnel, its public address
## (docs/how-to/github-app-tunnel.rst).
SITE_URL=
## The name of the site and of the GitHub App you register: unique on GitHub.
SITE_NAME=dashboard-dev-yourname
## The documentation of make livehtml, so that the error pages link to your changes.
DOCS_URL=http://localhost:8000/

## The GitHub App: register it on <SITE_URL>/setup/github-app/ (make run needs no setup code);
## the site writes these values into data/.env. Or set those of your development app here.
## The numeric id of the app.
# GITHUB_APP_ID=
## The name of the app in https://github.com/apps/<slug>.
# GITHUB_APP_SLUG=
## The client id of the app.
# GITHUB_CLIENT_ID=
## The client secret of the app.
# GITHUB_SECRET=
## The secret of the webhooks.
# GITHUB_WEBHOOK_SECRET=
## The file of the private key of the app.
# GITHUB_APP_PRIVATE_KEY_FILE=data/github-app.pem

## Required for signing in: an OAuth app with the callback URL
## <SITE_URL>/accounts/github/login/callback/; or enter it on <SITE_URL>/setup/oauth-app/.
## The client id of the OAuth app.
GITHUB_OAUTH_CLIENT_ID=
## The client secret of the OAuth app.
GITHUB_OAUTH_SECRET=

## Your GitHub handle: the Django admin, the log and the webhook deliveries.
SITE_ADMINS=
## The secret key and the SQLite database are created in data/ automatically.
