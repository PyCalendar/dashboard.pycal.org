#, python-format
msgid ""
"Hello,\n"
"\n"
"someone, probably you, added this email address to the account @%(user)s on "
"%(site_name)s.\n"
"\n"
"To verify it, open this link and press \"Verify\":\n"
"%(activate_url)s\n"
"\n"
"If it was not you, ignore this email: the address stays unverified and "
"%(site_name)s sends it nothing."
msgstr ""
"Hola:\n"
"\n"
"alguien, probablemente tú, añadió esta dirección de correo a la cuenta "
"@%(user)s en %(site_name)s.\n"
"\n"
"Para verificarla, abre este enlace y pulsa «Verificar»:\n"
"%(activate_url)s\n"
"\n"
"Si no fuiste tú, ignora este correo: la dirección sigue sin verificar y "
"%(site_name)s no le envía nada."

msgid "Verify your email address"
msgstr "Verifica tu dirección de correo"

