msgid ""
"Is <strong>%(address)s</strong> your email address? Verify it to receive "
"emails of %(site_name)s at it."
msgstr ""
"¿Es <strong>%(address)s</strong> tu dirección de correo? Verifícala para "
"recibir en ella los correos de %(site_name)s."

